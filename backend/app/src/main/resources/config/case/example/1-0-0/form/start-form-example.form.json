{
    "display": "form",
    "components": [
        {
            "key": "firstName",
            "type": "textfield",
            "input": true,
            "label": "First name",
            "tableView": true,
            "applyMaskOn": "change",
            "defaultValue": "Henk"
        },
        {
            "key": "recipients",
            "type": "textfield",
            "input": true,
            "label": "Recipients",
            "description": "One or more addresses, separated by a comma or a semicolon.",
            "tableView": true,
            "applyMaskOn": "change",
            "defaultValue": "henk.example@example.com, piet.example@example.com"
        },
        {
            "key": "cc",
            "type": "textfield",
            "input": true,
            "label": "CC",
            "description": "Stored as a list, so that both accepted shapes are covered by this form.",
            "multiple": true,
            "tableView": false,
            "applyMaskOn": "change",
            "defaultValue": [
                "cc.example@example.com"
            ]
        },
        {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Submit",
            "tableView": false,
            "disableOnInvalid": true
        }
    ]
}
